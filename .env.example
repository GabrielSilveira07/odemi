# URL pública (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://odemi.com.br

# Canais exibidos no site (deixe vazio para mostrar "A confirmar")
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=          # somente dígitos, ex.: 5541999999999

# Envio do formulário (Resend). Sem isso, a rota responde 503.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=                  # remetente de domínio verificado no Resend
