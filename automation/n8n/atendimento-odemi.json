    {
      "id": "8b8e5ab5-d9ae-490c-ac8d-f41449ebda0b",
      "name": "Registrar lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        280
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (phone, name, channel, last_message_at)\nVALUES ($1, NULLIF($2, ''), 'whatsapp', now())\nON CONFLICT (phone) DO UPDATE SET\n  name = COALESCE(leads.name, EXCLUDED.name),\n  last_message_at = now(),\n  updated_at = now()\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ $json.phone }},{{ $json.name }}"
        }
      },
