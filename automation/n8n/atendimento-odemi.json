    {
      "id": "8e1fc6ca-9e44-48c2-87cd-23d1dee9c28a",
      "name": "Normalizar WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Normaliza o evento messages.upsert da Evolution API (v2)\n// e decide a rota: comando | sem_texto | mensagem | ignorar\nconst body = $input.first().json.body ?? $input.first().json;\nconst data = body.data ?? {};\nconst key = data.key ?? {};\nconst jid = String(key.remoteJid ?? '');\nconst msg = data.message ?? {};\n\nconst text = String(\n  msg.conversation ??\n  msg.extendedTextMessage?.text ??\n  msg.imageMessage?.caption ??\n  msg.videoMessage?.caption ??\n  ''\n).trim();\n\n// telefone só com dígitos (seguro para SQL e para a Evolution)\nconst phone = jid.split('@')[0].replace(/\\D/g, '');\n// nome sem vírgulas: parâmetros de query do n8n são separados por vírgula\nconst name = String(data.pushName ?? '').replace(/,/g, ' ').trim().slice(0, 120);\n\nconst isGroup = jid.endsWith('@g.us') || jid.includes('broadcast');\nconst fromMe = key.fromMe === true;\nconst isCommand = fromMe && /^#bot\\s+(on|off)\\b/i.test(text);\n\nlet route = 'mensagem';\nif (body.event !== 'messages.upsert' || isGroup || !phone) route = 'ignorar';\nelse if (isCommand) route = 'comando';\nelse if (fromMe) route = 'ignorar';\nelse if (!text) route = 'sem_texto';\n\nreturn [{ json: {\n  route,\n  phone,\n  name,\n  text: text.slice(0, 4000),\n  botOff: isCommand ? /off/i.test(text) : null,\n  messageId: key.id ?? null,\n}}];"
      }
    },
